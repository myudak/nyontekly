{
  "name": "electron-web-tool",
  "version": "1.0.0",
  "private": true,
  "description": "Small capture-protected Electron window for a web tool",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package:win": "electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.electron.webtool",
    "asar": true,
    "files": [
      "main.js",
      "settings-preload.js",
      "settings.html",
      "settings.css",
      "settings.js",
      "tray.png",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "artifactName": "WebTool-${version}-portable.${ext}"
    }
  }
}
