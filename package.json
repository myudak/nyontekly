{
  "name": "electron-web-tool",
  "version": "1.0.0",
  "private": true,
  "description": "Floating assistant and capture workspace",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check renderer.js && node --check seb.js && node --check cleaner-runner.js && node --check pedal-runner.js && node --check sticky-store.js && node --check sticky-preload.js && node --check sticky.js",
    "test": "node --test test-seb.js test-cleaner.js test-pedal.js test-sticky.js",
    "package:win": "electron-builder --win portable --x64 --publish never",
    "screenshot": "node scripts/screenshot.js"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.electron.webtool",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "style.css",
      "renderer.js",
      "seb.js",
      "package.json",
      "voice/worker.py",
      "voice/requirements.txt",
      "cleaner-runner.js",
      "pedal-runner.js",
      "sticky-store.js",
      "sticky-preload.js",
      "sticky.html",
      "sticky.css",
      "sticky.js"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "artifactName": "Nyontekly-${version}-portable.${ext}"
    },
    "asarUnpack": [
      "voice/**"
    ]
  }
}
